{
    "name": "justinholtweb/craft-boomerang",
    "description": "Returns, RMAs and a store-credit wallet for Craft Commerce — a customer returns portal, a configurable RMA state machine, restock into inventory locations, exchange orders, refunds to store credit that spends like a payment method, carrier return labels and return analytics.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "commerce",
        "returns",
        "rma",
        "refunds",
        "store-credit",
        "exchanges",
        "ecommerce"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0",
        "craftcms/commerce": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\boomerang\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Boomerang",
        "handle": "boomerang",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-boomerang/blob/main/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-boomerang/main/CHANGELOG.md",
        "class": "justinholtweb\\boomerang\\Plugin"
    }
}
