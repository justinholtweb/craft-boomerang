{% extends 'boomerang/_emails/_base' %}

{% block subject %}{{ 'New return {reference}'|t('boomerang', { reference: return.reference }) }}{% endblock %}

{% block body %}
    <h1 style="font-size:20px;margin:0 0 12px;">{{ 'New return {reference}'|t('boomerang', { reference: return.reference }) }}</h1>

    <p style="margin:0 0 16px;">
        {{ return.email }}
        {%- if return.orderReference %} · {{ 'order'|t('boomerang') }} {{ return.orderReference }}{% endif -%}
        · {{ return.resolutionAmount|commerceCurrency(return.currency ?? 'USD') }}
    </p>

    <table style="width:100%;border-collapse:collapse;margin:0 0 16px;">
        {% for item in items %}
            <tr>
                <td style="padding:6px 0;border-top:1px solid #eee;">
                    {{ item.description }}<br>
                    <span style="color:#767676;font-size:14px;">{{ item.sku }} · {{ item.reasonLabel }}</span>
                    {% if item.customerComment %}
                        <br><em style="color:#767676;font-size:14px;">“{{ item.customerComment }}”</em>
                    {% endif %}
                </td>
                <td style="padding:6px 0;border-top:1px solid #eee;text-align:right;">× {{ item.qtyRequested }}</td>
            </tr>
        {% endfor %}
    </table>

    <p style="margin:0;">
        <a href="{{ return.cpEditUrl }}" style="display:inline-block;padding:10px 18px;background:#1b1b1b;color:#fff;border-radius:6px;text-decoration:none;">
            {{ 'Open it in the control panel'|t('boomerang') }}
        </a>
    </p>
{% endblock %}
